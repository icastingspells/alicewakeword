# Track only the standalone wakeword project; research stays on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/alicewakeword.py
!/requirements-build.txt
!/project.json
!/profiles/
!/device/
!/tools/
!/tests/
!/.github/
/device/*
!/device/native/
!/device/package/
!/device/README.md
/device/native/*
!/device/native/engine.c
!/device/native/kernels.h
!/device/native/alsa_tap.c
/tools/*
!/tools/public_cli.py
!/tools/compile_device_models.py
!/tools/package_device.py
!/tools/verify_device_models.py
!/tools/verify_device_stream.py
!/tools/test_device_launch_patch.py
__pycache__/
*.py[cod]
*.tflite
!/eva.tflite
*.onnx
*.wav
*.pcm
*.log
.env
*.pem
*.key
